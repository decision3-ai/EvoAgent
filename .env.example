# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────
POSTGRES_USER=agentevo
POSTGRES_PASSWORD=agentevo_secret
POSTGRES_DB=agentevo_db
DATABASE_URL=postgresql+asyncpg://agentevo:agentevo_secret@postgres:5432/agentevo_db

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────
# AI API Keys
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
