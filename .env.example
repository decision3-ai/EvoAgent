# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
APP_ENV=development           # production | development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────
POSTGRES_USER=agentevo
POSTGRES_PASSWORD=agentevo_secret
POSTGRES_DB=agentevo_db
DATABASE_URL=postgresql+asyncpg://agentevo:agentevo_secret@postgres:5432/agentevo_db

# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@your-db-host:5432/agentevo_db

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Production example:
# REDIS_URL=redis://your-redis-host:6379/0

# ─────────────────────────────────────────
# AI API Keys
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────
# CORS (backend)
# JSON array of allowed frontend origins
# ─────────────────────────────────────────
# ALLOWED_ORIGINS=["https://evoagent.io","https://www.evoagent.io"]

# ─────────────────────────────────────────
# Frontend (Next.js)
# Set these in Vercel dashboard for production
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production:
# NEXT_PUBLIC_API_URL=https://api.agentevo.io
# NEXT_PUBLIC_APP_URL=https://agentevo.io
